{
  "name": "@thallyssonklein/rules",
  "version": "0.4.0",
  "type": "module",
  "description": "Instala regras de código (Java, Kotlin mobile, Go, TypeScript, React, React Native) em projetos para uso com o Claude Code",
  "bin": {
    "rules": "bin/install.js"
  },
  "files": [
    "bin",
    "rules-golang",
    "rules-java",
    "rules-java-legacy",
    "rules-kotlin-mobile",
    "rules-react-native-base",
    "rules-react-native-full",
    "rules-reactjs-base",
    "rules-reactjs-full",
    "rules-typescript",
    "rules-typescript-design-patterns",
    "rules-typescript-no-hexagonal"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thallyssonklein/Rules.git"
  },
  "license": "MIT"
}
